# Local dev: point the browser at the standalone API (uvicorn esp_atlas_api.main:app --port 8000).
# Leave unset in production — the site calls /api on the same origin (see vercel.json).
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub repo the "Edit on GitHub" / contribute links point at (override in a fork).
NEXT_PUBLIC_REPO_URL=https://github.com/fcavalcantirj/esp-atlas

# Canonical site URL (metadata, sitemap, robots). Defaults to https://esp-atlas.com.
# NEXT_PUBLIC_SITE_URL=https://esp-atlas.com

# GA4 measurement ID. Production builds default to the esp-atlas.com property when
# unset; dev builds send nothing unless you set this. NEXT_PUBLIC_GA_DEBUG=1 tags
# every event with debug_mode so it shows in GA4 DebugView.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GA_DEBUG=1

# Server-side API base for server components / sitemap when the defaults
# (absolute NEXT_PUBLIC_API_URL, else the Vercel deployment URL + /api) don't fit.
# API_INTERNAL_URL=http://localhost:8000
