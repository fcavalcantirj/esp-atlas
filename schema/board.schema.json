{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp.wiki/schema/board.schema.json",
  "title": "ESP Development Board",
  "description": "A dev board built on a module (or a bare SoC). Inherits radio/CPU specs through `module` -> `soc`. State exactly one of `module` or `soc`. Every added spec carries a source.",
  "type": "object",
  "required": ["id", "type", "brand", "name", "sources"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["module"] },
    { "required": ["soc"] }
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "type": { "const": "board" },
    "brand": { "type": "string", "description": "vendor/maker; matches data/boards/<brand>/ folder" },
    "name": { "type": "string" },
    "aka": { "type": "array", "items": { "type": "string" } },
    "module": { "type": "string", "description": "id of the module it uses (must exist in data/modules/)" },
    "soc": { "type": "string", "description": "id of the SoC, when the board uses a bare chip (must exist in data/socs/)" },
    "form_factor": { "type": "string" },
    "dimensions_mm": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
    "usb": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "connector": { "enum": ["usb-c", "micro-usb", "mini-usb", "none"] },
        "bridge": { "type": "string", "description": "USB-UART bridge chip (e.g. cp2102, ch340) or 'native' if the SoC's own USB is used" }
      }
    },
    "power": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "battery_connector": { "type": "boolean" },
        "charging": { "type": "boolean" }
      }
    },
    "display": { "type": "string", "description": "e.g. '1.9in 170x320 IPS' — only if the board has an onboard display" },
    "extras": { "type": "array", "items": { "type": "string" }, "description": "onboard peripherals: sd-card, imu, mic, rgb-led, gps, etc." },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["field", "url", "verified"], "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "verified": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
