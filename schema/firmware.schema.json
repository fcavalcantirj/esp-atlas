{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp.wiki/schema/firmware.schema.json",
  "title": "ESP Atlas Firmware",
  "description": "A flashable ESP32 firmware project. First-class entity like `brand`: never indexed into the queryable parts table, never a /search or /wizard result. See SPEC-wizard.md.",
  "type": "object",
  "required": ["id", "type", "name", "url", "category", "socs", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "matches the data/firmware/<id>/ folder" },
    "type": { "const": "firmware" },
    "name": { "type": "string" },
    "url": { "type": "string", "format": "uri", "description": "project repo" },
    "category": { "enum": ["pentest", "mesh", "badusb", "display", "home", "multi"] },
    "maintainer": { "type": "string" },
    "license": { "type": "string", "description": "SPDX identifier" },
    "distribution": {
      "type": "array",
      "items": { "enum": ["m5burner", "releases", "web-flasher", "esp-web-tools"] }
    },
    "manifest_url": { "type": "string", "format": "uri" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "socs": {
      "type": "array", "minItems": 1, "items": { "type": "string" },
      "description": "SoC families the project builds for"
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["field", "url", "verified"], "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "verified": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
