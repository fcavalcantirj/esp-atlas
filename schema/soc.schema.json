{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp.wiki/schema/soc.schema.json",
  "title": "ESP SoC",
  "description": "Frontmatter contract for a single Espressif System-on-Chip. Every hard spec MUST carry a source. Fields not yet verified are omitted, never guessed.",
  "type": "object",
  "required": ["id", "type", "vendor", "name", "cpu", "memory", "radios", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "kebab-case, matches folder name" },
    "type": { "const": "soc" },
    "vendor": { "type": "string" },
    "name": { "type": "string" },
    "aka": { "type": "array", "items": { "type": "string" } },
    "cpu": {
      "type": "object",
      "required": ["arch", "cores", "max_mhz"],
      "additionalProperties": false,
      "properties": {
        "arch": { "enum": ["xtensa-lx6", "xtensa-lx7", "risc-v"] },
        "cores": { "type": "integer", "minimum": 1 },
        "max_mhz": { "type": "integer" },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "lp_core": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "arch": { "type": "string" }, "max_mhz": { "type": "integer" } }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["sram_kb"],
      "additionalProperties": false,
      "properties": {
        "sram_kb": { "type": "integer" },
        "lp_sram_kb": { "type": "integer" },
        "rtc_sram_kb": { "type": "integer" },
        "rom_kb": { "type": "integer" },
        "in_package_psram_mb": { "type": "array", "items": { "type": "integer" } },
        "psram_external": { "type": "boolean" }
      }
    },
    "radios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wifi": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "standard": { "enum": ["wifi-4", "wifi-6"] },
            "bands_ghz": { "type": "array", "items": { "enum": [2.4, 5] } }
          }
        },
        "bluetooth": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "le": { "type": "string", "description": "BLE core version as printed by the datasheet" },
            "classic": { "type": "boolean", "description": "Bluetooth Classic (BR/EDR) support" },
            "features": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ieee802154": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "present": { "type": "boolean" },
            "protocols": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "usb": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "boolean" },
        "type": { "type": "string" }
      }
    },
    "interfaces": { "type": "array", "items": { "type": "string" } },
    "security": { "type": "array", "items": { "type": "string" } },
    "drive": {
      "type": "object", "additionalProperties": false,
      "description": "Per-pad GPIO electrical drive limits — silicon-level, datasheet-sourced (SPEC-io-power.md §2). Abs-max; per-pin defaults go in notes, not this scalar.",
      "properties": {
        "gpio_source_ma_max": { "type": "number" },
        "gpio_sink_ma_max": { "type": "number" },
        "gpio_pads_total": { "type": "number" }
      }
    },
    "reserved_pins": {
      "type": "object", "additionalProperties": false,
      "description": "Pads that don't count toward a board's usable GPIO — official, Espressif Hardware Design Guidelines-sourced (SPEC-io-power.md §3a).",
      "properties": {
        "strapping": { "type": "array", "items": { "type": "number" } },
        "input_only": { "type": "array", "items": { "type": "number" } },
        "usb_flash_tied": { "type": "array", "items": { "type": "number" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "url", "verified"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "description": "'*' = whole record, or a dotted path like radios.bluetooth" },
          "url": { "type": "string", "format": "uri" },
          "verified": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
