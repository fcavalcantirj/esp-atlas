{
  "name": "esp-atlas",
  "private": true,
  "description": "Repo-root convenience scripts. The actual apps live in apps/*; this file only exists so `npm test`/`npm run test:coverage` gives contributors a familiar entrypoint into the Python test suite.",
  "scripts": {
    "test": "python3 -m pytest apps/core/tests apps/api/tests apps/cli/tests",
    "test:coverage": "scripts/coverage.sh",
    "inference:oracle": "python3 scripts/inference_oracle.py",
    "validate:data": "python3 scripts/validate_data.py",
    "boot:coverage": "python3 scripts/boot_coverage.py",
    "data:completion": "python3 scripts/data_completion.py",
    "build-guide:oracle": "python3 scripts/build_guide_oracle.py",
    "clarify:oracle": "python3 scripts/clarify_oracle.py"
  }
}
