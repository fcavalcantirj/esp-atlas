{
  "buildCommand": "npm --prefix apps/web install && npm --prefix apps/web run build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "functions": {
    "api/index.py": { "includeFiles": "{data,schema,apps}/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
