# Backend (apps/api) environment. Copy to .env.local (gitignored) for local dev.
# Frontend variables live in apps/web/.env.example.
#
# Groq API key for the Ask endpoint. NEVER commit a real value — this file is
# documentation only. Local dev: export it or put it in .env.local. Production:
# set it in the Vercel project's environment variables.
# Without it, /ask returns 503 and the deterministic wizard/search still work.
GROQ_API_KEY=

# Optional: override the pinned chat model. Which models a key can reach is
# account-specific — check GET https://api.groq.com/openai/v1/models before
# setting this. Default: openai/gpt-oss-120b (apps/core esp_atlas_core/llm.py).
# GROQ_MODEL=
